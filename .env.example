# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
# Must be a public HTTPS URL reachable by both Meta and Safaricom (use ngrok in dev).
PUBLIC_BASE_URL=https://your-ngrok-or-domain.example.com

# ── WhatsApp Cloud API (Meta for Developers) ───────────────────────────────
# System User permanent token, from Business Settings (temporary tokens expire in 24h).
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890123
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123
# You choose this string yourself; it must match the value you enter in the
# Meta App Dashboard -> WhatsApp -> Configuration -> Webhook -> Verify Token.
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
# Optional but recommended: App Secret, used to verify X-Hub-Signature-256 on
# inbound webhook calls so third parties can't spoof messages to your bot.
WHATSAPP_APP_SECRET=

# ── Safaricom Daraja (M-Pesa) — sandbox by default ─────────────────────────
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-sandbox-consumer-key
MPESA_CONSUMER_SECRET=your-sandbox-consumer-secret
# Sandbox STK Push shortcode + passkey (public values from Daraja docs).
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Required only for B2C / B2B (send money) — NOT required for STK Push (pay-in).
MPESA_INITIATOR_NAME=testapi
# Initiator password encrypted with Safaricom's public certificate (base64).
# Generate this once, offline — see README.md for how.
MPESA_SECURITY_CREDENTIAL=

# ── Allow-list: who can trigger real money movement over WhatsApp ─────────
# Comma-separated MSISDNs (e.g. 254712345678,254798765432).
# Leave blank to allow any WhatsApp sender to trigger payments — NOT recommended.
ALLOWED_WHATSAPP_SENDERS=2547XXXXXXXX
